# Browser-safe Supabase configuration (Nexus 전용 프로젝트)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. 회원 관리(/api/admin/members)와 자동화 라우트에 필요.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only. AI 팀장 대리 (DeepSeek, OpenAI 호환 API)
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# GET /models로 확인한 모델 ID (2026-09-29)
DEEPSEEK_MODEL=deepseek-v4-pro

# 넥서스 표가 있는 스키마 (공유 프로젝트의 public 과 분리)
NEXT_PUBLIC_NEXUS_DB_SCHEMA=harim_nexus

# 선택: 설정하면 가입 화면에서 이 팀 가입코드를 입력해야 가입된다 (비우면 누구나 가입)
NEXUS_SIGNUP_CODE=

# 선택: 예약 실행(/api/cron/*) 보호용. Vercel Cron 은 자동으로 이 값을 Bearer 로 보낸다
CRON_SECRET=
